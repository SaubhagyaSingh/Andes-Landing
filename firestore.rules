rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {
      allow create: if request.auth != null;

      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.email == "ceo@andes.co.in" ||
        request.auth.token.email == "signaturegrowthcapital@andes.co.in"
      );

      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.email == "ceo@andes.co.in"
      );

      allow update: if request.auth != null
        && request.auth.uid == "WYapQzCJbGT6hou4mRJAUCjzHEU2"
        && request.resource.data.diff(resource.data)
             .changedKeys()
             .hasOnly(['zoneStatus', 'zoneTime', 'updatedAt']);
    }

    match /riders/{riderId} {
      allow read: if request.auth != null ||
                   (request.query.limit == 1 &&
                    (request.query.filters[0].field == 'email' ||
                     request.query.filters[0].field == 'phone'));
      allow create: if true;
      allow update: if request.auth != null && request.auth.uid == riderId;
      allow delete: if request.auth != null && request.auth.uid == riderId;
      allow list: if request.auth != null;
      allow get: if request.auth != null;
    }

    match /stores/{storeId} {
      allow read: if request.auth != null ||
                   (request.query.limit == 1 &&
                    (request.query.filters[0].field == 'email' ||
                     request.query.filters[0].field == 'phone'));
      allow create: if true;
      allow update: if request.auth != null && request.auth.uid == storeId;
      allow delete: if request.auth != null && request.auth.uid == storeId;
      allow list: if request.auth != null;
      allow get: if request.auth != null;

      // ── Attendance: worker registry ─────────────────────────────────────
      match /attendance_workers/{workerId} {
        allow read, list, get: if request.auth != null && (
          request.auth.uid == storeId ||
          request.auth.token.email == "andesnow1604@gmail.com" ||
          request.auth.token.email == "ceo@andes.co.in"
        );
        allow create, update: if request.auth != null
          && request.auth.uid == storeId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.role is string;
        allow delete: if request.auth != null && request.auth.uid == storeId;
      }

      // ── Attendance: daily records ────────────────────────────────────────
      match /attendance/{date}/records/{workerId} {
        allow read, list, get: if request.auth != null && (
          request.auth.uid == storeId ||
          request.auth.token.email == "andesnow1604@gmail.com" ||
          request.auth.token.email == "ceo@andes.co.in"
        );

        allow create: if request.auth != null
          && request.auth.uid == storeId
          && request.resource.data.workerId is string
          && request.resource.data.workerName is string
          && request.resource.data.date is string
          && request.resource.data.checkIn is timestamp
          && request.resource.data.status in ['present', 'late', 'absent'];

        allow update: if request.auth != null
          && request.auth.uid == storeId
          && request.resource.data.diff(resource.data)
               .changedKeys()
               .hasOnly(['checkOut', 'checkOutPhotoUrl', 'totalHours', 'overtimeHours']);

        allow delete: if false;
      }
    }

    match /users/{userId} {
      allow read: if request.auth != null ||
                   (request.query.limit == 1 && request.query.filters[0].field == 'mobile');
      allow create: if true;
      allow update: if request.auth != null &&
        (request.auth.uid == userId ||
         resource.data.mobile == request.resource.data.mobile);
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null;
      allow get: if request.auth != null;

      match /addresses/{addressId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /users/{docId} {
      allow read: if true;
    }

    match /addresses/{addressId} {
      function hasAccessToAddress() {
        return resource.data.userId == request.auth.uid ||
               resource.data.phoneNumber == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.mobile ||
               (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data._id == resource.data.userId);
      }

      function isValidLocation() {
        let data = request.resource.data;
        return !('location' in data) ||
               (data.location is map &&
                data.location.latitude is number &&
                data.location.longitude is number);
      }

      allow read: if request.auth != null && hasAccessToAddress();
      allow list: if request.auth != null;
      allow create: if request.auth != null && isValidLocation();
      allow update: if request.auth != null &&
                     (hasAccessToAddress() ||
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'updatedAt']))) &&
                     isValidLocation();
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /cartdetails/{orderId} {
      function hasAccessToOrder() {
        return resource.data.userId == request.auth.uid ||
               resource.data.userMobile == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.mobile ||
               (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data._id == resource.data.userId);
      }
      allow read, list, write: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'riderId', 'riderName', 'updatedAt']);
      match /{allPaths=**} {
        allow read, write: if true;
      }
    }

    match /cartdetails/{docId} {
      allow read: if true;
    }

    match /coupons/{couponId} {
      allow read: if request.auth != null &&
              (resource.data.isGlobal == true ||
               resource.data.userId == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
                resource.data.userId == request.auth.uid &&
                request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly(['userId', 'updatedAt']);
      allow delete: if request.auth != null &&
                 resource.data.userId == request.auth.uid;
    }

    match /counters/{counterId} {
      allow read, write: if request.auth != null;
    }

    match /prices/{priceId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null &&
                                     request.auth.token.email == "andesnow1604@gmail.com";
    }

    match /wallets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0
          && request.resource.data.createdAt is timestamp)
        ||
        (request.auth.uid != userId
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0
          && request.resource.data.balance <= 100)
      );

      allow update: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0
          && (!('createdAt' in resource.data) || resource.data.createdAt == request.resource.data.createdAt))
        ||
        (request.auth.uid != userId
          && (
            (!exists(/databases/$(database)/documents/wallets/$(userId))
             && request.resource.data.balance is number
             && request.resource.data.balance >= 0
             && request.resource.data.balance <= 100)
            ||
            (exists(/databases/$(database)/documents/wallets/$(userId))
             && request.resource.data.balance is number
             && request.resource.data.balance >= 0
             && request.resource.data.balance <= 1000)
          ))
      );

      match /transactions/{transactionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && (
          (request.auth.uid == userId
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            && request.resource.data.type in ['credit', 'debit']
            && request.resource.data.timestamp is timestamp
            && request.resource.data.description is string)
          ||
          (request.auth.uid != userId
            && request.resource.data.amount is number
            && (request.resource.data.amount == 30.0 || request.resource.data.amount == 50.0)
            && request.resource.data.type == 'credit'
            && request.resource.data.timestamp is timestamp
            && request.resource.data.description is string
            && request.resource.data.description.matches('.*[Rr]eferral.*'))
        );
      }
    }

    match /used_coupons/{couponId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    match /rush_hour/{document=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                  request.auth.token.email == "andesnow1604@gmail.com";
    }

    match /hostels_orders/{orderId} {
      function isAndesAdmin() {
        return request.auth.token.email == "andesnow1604@gmail.com"
            || request.auth.token.email == "ceo@andes.co.in";
      }

      allow read: if request.auth != null &&
                 (request.auth.uid == resource.data.userId ||
                  request.auth.token.email == "andesnow1604@gmail.com");
      allow read: if request.auth != null && isAndesAdmin();

      // ── UPDATED: Allow public submissions from the website ──
      allow create: if
        request.resource.data.status == "pending"
        && request.resource.data.userId == ""
        && request.resource.data.hostel is string
        && request.resource.data.hostel.size() > 0
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userEmail is string
        && request.resource.data.userMobile is string
        && request.resource.data.clothes is string
        && request.resource.data.room is string
        && request.resource.data.room.size() > 0;
        
      allow create: if request.auth != null && isAndesAdmin();

      allow update: if request.auth != null
                    && (
                         request.auth.uid == resource.data.userId
                         || request.auth.token.email == "andesnow1604@gmail.com"
                         || (resource.data.riderId is string
                             && request.auth.uid == resource.data.riderId)
                         || (!(resource.data.keys().hasAll(['riderId']) && resource.data.riderId != null)
                             && request.resource.data.riderId == request.auth.uid)
                         || request.auth.uid == resource.data.storeId
                       )
                    && request.resource.data.diff(resource.data)
                         .changedKeys()
                         .hasOnly(['status','updatedAt','riderId','clothesCount','clothesWeightKg','zoneStatus','zoneTimes', 'verifiedByClient']);
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .changedKeys()
                         .hasOnly(['status','updatedAt'])
                    && request.resource.data.status in ['processing', 'out for delivery', 'delivered', 'completed'];
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .changedKeys()
                         .hasOnly(['zoneStatus','zoneTimes','status','updatedAt']);
      allow update: if request.auth != null && isAndesAdmin();

      allow delete: if request.auth != null &&
                   (request.auth.uid == resource.data.userId ||
                    request.auth.token.email == "andesnow1604@gmail.com");
      allow delete: if request.auth != null && isAndesAdmin();

      allow list, get: if request.auth != null;
    }

    match /complaint/{complaintId} {
      allow read, list, get: if request.auth != null;

      // Path 1: authenticated in-app complaint, tied to a specific order.
      allow create: if request.auth != null &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.orderId is string &&
                    request.resource.data.userId is string &&
                    request.resource.data.userName is string &&
                    request.resource.data.hostel is string &&
                    request.resource.data.room is string &&
                    request.resource.data.issue is string &&
                    (request.resource.data.photoUrls == null || request.resource.data.photoUrls is list) &&
                    request.resource.data.status == 'open' &&
                    request.resource.data.createdAt is timestamp &&
                    request.resource.data.updatedAt is timestamp;

      // Path 2: unauthenticated hostel-web-pickup complaint, no order attached.
      allow create: if
                    request.resource.data.status == "open"
                    && request.resource.data.flagged == false
                    && request.resource.data.userId == ""
                    && request.resource.data.hostel is string
                    && request.resource.data.hostel.size() > 0
                    && request.resource.data.userName is string
                    && request.resource.data.userName.size() > 0
                    && request.resource.data.userMobile is string
                    && request.resource.data.userMobile.size() > 0
                    && request.resource.data.room is string
                    && request.resource.data.room.size() > 0
                    && request.resource.data.issue is string
                    && request.resource.data.issue.size() > 0
                    && request.resource.data.photoUrls is list
                    && request.resource.data.photoUrls.size() <= 4;

      allow update: if request.auth != null && (
                      (request.auth.uid == resource.data.userId &&
                        request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','updatedAt']))
                      ||
                      ((('storeId' in resource.data) && resource.data.storeId == request.auth.uid) &&
                        request.resource.data.diff(resource.data).changedKeys().hasOnly(['status','updatedAt']))
                      ||
                      (!(('storeId' in resource.data) && resource.data.storeId is string) &&
                        request.resource.data.storeId == request.auth.uid &&
                        request.resource.data.diff(resource.data).changedKeys().hasOnly(['storeId','status','updatedAt']))
                    );
      allow delete: if false;
    }

    match /normal_complaint/{complaintId} {
      function isAdmin() {
        return request.auth.token.email == "andesnow1604@gmail.com"
          || request.auth.token.email == "ceo@andes.co.in";
      }

      function isStore() {
        return exists(/databases/$(database)/documents/stores/$(request.auth.uid));
      }

      allow get, list, read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin() || isStore());

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.userName is string
        && request.resource.data.issue is string
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!('photoUrls' in request.resource.data)
            || request.resource.data.photoUrls is list);

      allow update: if request.auth != null && (
        (
          resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt'])
        ) ||
        (
          isAdmin()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'adminNote', 'updatedAt'])
        ) ||
        (
          isStore()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt'])
        )
      );

      allow delete: if false;
    }

    match /user_coupons/{couponId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow list: if request.auth != null;
      allow delete: if false;
    }

    match /referralCodes/{code} {
      allow get, list: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.ownerUserId == request.auth.uid;

      allow update: if request.auth != null
        && request.resource.data.ownerUserId == resource.data.ownerUserId;

      match /applied/{applierId} {
        allow get: if request.auth != null && applierId == request.auth.uid;
        allow create: if request.auth != null
          && applierId == request.auth.uid
          && !exists(/databases/$(database)/documents/referralCodes/$(code)/applied/$(applierId));
      }
    }

    match /user_analytics/{analyticsId} {
      allow read: if request.auth != null
        && (resource.data.userId == resource.data.userId || request.auth.uid == 'anonymous');
      allow create: if request.auth != null
        && (request.resource.data.userId == request.auth.uid
            || request.resource.data.userId == 'anonymous')
        && request.resource.data.type is string
        && request.resource.data.type in ['search', 'screen_view', 'custom_event']
        && request.resource.data.timestamp is timestamp;
      allow update, delete: if false;
      allow list: if request.auth != null;
    }

    match /analytics/searches {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;

      match /popular/{query} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.query is string
          && request.resource.data.count is int
          && request.resource.data.count == 1
          && (request.resource.data.firstSearched is timestamp || request.resource.data.firstSearched == null)
          && (request.resource.data.lastSearched is timestamp || request.resource.data.lastSearched == null);
        allow update: if request.auth != null
          && request.resource.data.count is int
          && request.resource.data.count > 0;
        allow delete: if false;
      }
    }

    match /analytics/screens/popular/{screenName} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.screenName is string
        && request.resource.data.visitCount is int
        && request.resource.data.visitCount == 1
        && (request.resource.data.firstVisited is timestamp || request.resource.data.firstVisited == null)
        && (request.resource.data.lastVisited is timestamp || request.resource.data.lastVisited == null);
      allow update: if request.auth != null
        && request.resource.data.screenName is string
        && request.resource.data.visitCount is int
        && request.resource.data.visitCount > 0
        && (request.resource.data.lastVisited is timestamp || request.resource.data.lastVisited == null);
      allow delete: if false;
    }

    match /b2b_revenue/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == "andesnow1604@gmail.com";
    }

    match /riderDeviceTokens/{token} {
      function isOwner() {
        return request.auth != null
          && request.resource.data.uid == request.auth.uid;
      }

      allow create, update: if isOwner();
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /b2b_orders/{orderId} {
      function isAuthed() {
        return request.auth != null;
      }

      function isOwnerOrAdmin() {
        return isAuthed() && (
          (resource.data.keys().hasAll(['riderId']) && resource.data.riderId == request.auth.uid)
          || request.auth.token.email == "andesnow1604@gmail.com"
          || request.auth.token.email == "ceo@andes.co.in"
        );
      }

      allow create: if isAuthed()
        && request.resource.data.createdAt is timestamp;

      allow get, list: if isAuthed();

      allow update, delete: if isOwnerOrAdmin();
      allow update: if isAuthed() && request.resource.data.diff(resource.data).changedKeys().hasOnly(['verifiedByClient']);
    }

    match /b2b_partner/{partnerId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && (request.auth.token.email == "andesnow1604@gmail.com"
            || request.auth.token.email == "ceo@andes.co.in");
    }

    match /b2b_managers/{managerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        (request.auth.token.email == "andesnow1604@gmail.com" ||
         request.auth.token.email == "ceo@andes.co.in");
    }

    match /b2b_admin_edits/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /b2b_expenses/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /available_coupons/{couponId} {
      allow read, list, get: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == "andesnow1604@gmail.com";

      function isValidCoupon() {
        let d = request.resource.data;
        return d.code is string
          && d.code.size() > 0
          && (!('discountPercentage' in d) || d.discountPercentage is number)
          && (!('upto' in d) || d.upto is number)
          && (!('minOrder' in d) || d.minOrder is number)
          && (!('freeDelivery' in d) || d.freeDelivery is bool)
          && (!('requiresUniform' in d) || d.requiresUniform is bool)
          && (!('isActive' in d) || d.isActive is bool);
      }

      allow create, update: if request.auth != null
        && request.auth.token.email == "andesnow1604@gmail.com"
        && isValidCoupon();
    }

    match /fee_config/{docId} {
      allow read: if request.auth != null;

      function isValidFeeConfig() {
        let d = request.resource.data;
        return (!('regularConvenienceFee' in d) || (d.regularConvenienceFee is number && d.regularConvenienceFee >= 0))
          && (!('instantConvenienceFee' in d) || (d.instantConvenienceFee is number && d.instantConvenienceFee >= 0))
          && (!('deliveryFee' in d) || (d.deliveryFee is number && d.deliveryFee >= 0))
          && (!('showStrikethroughWhenConvenienceFee' in d) || (d.showStrikethroughWhenConvenienceFee is number && d.showStrikethroughWhenConvenienceFee >= 0))
          && (!('showStrikethroughWhenDeliveryFee' in d) || (d.showStrikethroughWhenDeliveryFee is number && d.showStrikethroughWhenDeliveryFee >= 0));
      }

      allow create, update: if request.auth != null
        && (request.auth.token.email == "andesnow1604@gmail.com"
            || request.auth.token.email == "ceo@andes.co.in")
        && isValidFeeConfig();

      allow delete: if request.auth != null
        && (request.auth.token.email == "andesnow1604@gmail.com"
            || request.auth.token.email == "ceo@andes.co.in");
    }

    match /andes_tm_users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /andes_tm_tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    match /timings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.admin == true;
    }

    match /company_config/{document=**} {
      allow read, write: if request.auth != null && (
        request.auth.token.email == "andesnow1604@gmail.com" ||
        request.auth.token.email == "ceo@andes.co.in"
      );
    }

    match /store_settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.token.email == "andesnow1604@gmail.com"
            || request.auth.token.email == "ceo@andes.co.in");
    }

    match /qr_scans/{doc} {
      allow create: if true;
      allow read: if false;
    }

    match /meta_ads_leads/{docId} {
      allow read, list, get: if request.auth != null && (
        request.auth.token.email == "andesnow1604@gmail.com" ||
        request.auth.token.email == "ceo@andes.co.in" ||
        request.auth.token.email == "signaturegrowthcapital@andes.co.in"
      );
      allow create: if request.auth != null && (
        request.auth.token.email == "andesnow1604@gmail.com" ||
        request.auth.token.email == "ceo@andes.co.in"
      );
      allow update: if request.auth != null && (
        request.auth.token.email == "andesnow1604@gmail.com" ||
        request.auth.token.email == "ceo@andes.co.in"
      ) && request.resource.data.diff(resource.data)
           .changedKeys()
           .hasOnly(['status', 'remarks', 'location', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    match /meta_ads_settings/{docId} {
      allow read: if request.auth != null && (
        request.auth.token.email == "ceo@andes.co.in" ||
        request.auth.token.email == "signaturegrowthcapital@andes.co.in"
      );
      allow write: if request.auth != null && (
        request.auth.token.email == "ceo@andes.co.in"
      );
    }

    // Hostel Messages queue security rules
    match /hostel_messages/{messageId} {
      allow create, read: if request.auth != null && (
        request.auth.token.email == "ceo@andes.co.in" ||
        request.auth.token.email == "andesnow1604@gmail.com" ||
        request.auth.token.email == "signaturegrowthcapital@andes.co.in"
      );
    }

    // Catch-all: everything else requires auth.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
